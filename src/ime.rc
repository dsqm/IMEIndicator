/* VERSIONINFO resource. Version = build date.
   Values come from src\version.h, auto-generated by the build scripts
   (build.bat / CI) from the current date. ASCII only: rc.exe is picky. */
#include <windows.h>
#include "version.h"

1 VERSIONINFO
FILEVERSION    IME_VER_YEAR,IME_VER_MONTH,IME_VER_DAY,0
PRODUCTVERSION IME_VER_YEAR,IME_VER_MONTH,IME_VER_DAY,0
FILEOS         0x40004L   /* VOS_NT_WINDOWS32 */
FILETYPE       0x1L       /* VFT_APP */
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "IMEIndicator"
            VALUE "FileVersion",     IME_VER_A
            VALUE "ProductName",     "IMEIndicator"
            VALUE "ProductVersion",  IME_VER_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
